# Hermes Alive — Environment Variables Template
# Optional advanced overrides. Normal installation writes profile-owned config.

# ── Core ────────────────────────────────────────────────────────────────
HERMES_PROACTIVE_PLATFORM_ENABLED=true
# Leave empty to capture the Hermes conversation used during setup.
HERMES_PROACTIVE_DELIVERY_PLATFORM=
HERMES_PROACTIVE_DELIVERY_CHAT_ID=
HERMES_PROACTIVE_PLATFORM_INTERVAL_SECONDS=300

# ── Subsystems ──────────────────────────────────────────────────────────
VOICE_ENABLED=true
COOLDOWN_ENABLED=true

# ── LLM ─────────────────────────────────────────────────────────────────
HERMES_PROACTIVE_LLM_ENABLED=true
# Empty means inherit Hermes primary model and provider routing.
HERMES_PROACTIVE_LLM_MODEL=
HERMES_PROACTIVE_LLM_TIMEOUT=60

# ── Discovery (content sources) ─────────────────────────────────────────
HERMES_PROACTIVE_DISCOVERY_ENABLED=true
HERMES_PROACTIVE_DISCOVERY_INTERVAL_SECONDS=14400
# Empty means inherit Hermes fallback routing.
HERMES_PROACTIVE_LLM_FALLBACK_MODEL=

# ── Dream (memory consolidation) ────────────────────────────────────────
HERMES_DREAM_ENABLED=true
HERMES_DREAM_INTERVAL_HOURS=24

# ── Cooldown ────────────────────────────────────────────────────────────
HERMES_PROACTIVE_COOLDOWN_MINUTES=120
HERMES_PROACTIVE_QUIET_START=0:30
HERMES_PROACTIVE_QUIET_END=8:30

# ── Playwright ──────────────────────────────────────────────────────────
PLAYWRIGHT_BROWSERS_PATH=${HERMES_HOME}/.playwright-browsers

# ── Weather (optional; normally written by lifecycle configure) ─────────
# HERMES_PROACTIVE_WEATHER_ENABLED=true
# HERMES_PROACTIVE_WEATHER_LOCATION_CONFIRMED=true
# HERMES_PROACTIVE_WEATHER_LOCATION_NAME=Singapore · Tampines
# HERMES_PROACTIVE_WEATHER_ADMIN3=Tampines
# HERMES_PROACTIVE_WEATHER_TIMEZONE=Asia/Singapore
# HERMES_PROACTIVE_LAT=1.352100
# HERMES_PROACTIVE_LON=103.944000

# ── Home ─────────────────────────────────────────────────────────────────
HERMES_HOME=~/.hermes
HERMES_STATE_DB=${HERMES_HOME}/state.db

# ── Discovery (advanced) ────────────────────────────────────────────────
HERMES_ALIVE_SHARED_DIR=${HERMES_HOME}/plugin-data/hermes-alive/runtime
HERMES_SOURCES_CONFIG=${HERMES_ALIVE_SHARED_DIR}/sources.yaml
HERMES_DISCOVERY_WORK_DIR=
HERMES_DISCOVERY_LOG_PATH=${HERMES_HOME}/logs/gateway.log
HERMES_DISCOVERY_LOCAL_ENABLED=false
HERMES_DISCOVERY_ALLOWED_ROOTS=
HERMES_DISCOVERY_MAX_FILES=100
HERMES_DISCOVERY_MAX_FILE_SIZE=262144
HERMES_DISCOVERY_MAX_TODO_RESULTS=5
HERMES_DISCOVERY_MAX_RECENT_FILES=5
HERMES_DISCOVERY_BUDGET_MAX_PER_RUN=15
HERMES_DISCOVERY_BUDGET_MAX_PER_SOURCE=5
HERMES_DISCOVERY_SHARE_THRESHOLD_MIN_SCORE=0.6

# ── Dream diff path ─────────────────────────────────────────────────────
DREAM_DIFF_PATH=${HERMES_ALIVE_SHARED_DIR}/dream_diff.json
